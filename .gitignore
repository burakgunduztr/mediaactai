# Model weights and download caches (setup downloads, not source)
.cache/
.huggingface/
models/
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# `models/` above is case-insensitively catching the C# record folders named
# Models/ (TempScore.Core/Models/, and later app/Models/ on the ThinkPad) on
# this filesystem (core.ignorecase=true) — those are source, not weights.
!TempScore.Core/Models/
!app/Models/

# Pipeline run output
runs/
frames/
cuts.log
score.wav
test.wav
output.mp4

# Sample media. Clips already committed stay tracked; new files dropped
# into samples/ stay local.
samples/

# Local planning (not source)
epic/
notes/

# OS
.DS_Store
.AppleDouble
._*
.LSOverride
Thumbs.db
Desktop.ini

# Editors (local only; agent configs under .cursor/.claude/.codex stay tracked)
.idea/
*.swp
