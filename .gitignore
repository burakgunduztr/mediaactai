# MSIX / Store packaging output, and the temporary signing key Visual Studio
# generates next to the project. Publish profiles stay tracked; their output
# lands under bin/, which is already ignored.
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload
