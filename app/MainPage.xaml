<!--
  TMT-13: top bar (open video, engine status, "Score it"), left
  MediaPlayerElement, right step list + editable plan — per MED-17's
  Behavior section. All pipeline logic lives in Orchestrator.cs; this file
  only binds controls to MainPage.xaml.cs's event handlers and observable
  collections, per the "no pipeline logic in MainPage.xaml.cs" AC.

  MED-18/TMT-14 addition: a Regenerate button and a mood slider + Apply
  button under the plan panel. Both only raise click events that
  MainPage.xaml.cs forwards into Orchestrator -- see that file's header for
  what's in/out of scope (the offline badge, TMT-14's third item, is not
  included).

  UNVERIFIED ON MAC: there is no WinUI 3 / Windows App SDK on macOS, so
  this markup has never been through the XAML compiler. It assumes the
  WinUI 3 project created per notes/GUIDE_3.md names its root namespace
  TempScore.App and that MainPage is added as a Page under app/ — if the
  ThinkPad project differs, x:Class below needs to match. See
  notes/GUIDE_7.md and notes/GUIDE_9.md for what to check/fix on the
  ThinkPad before this compiles and runs.
-->
<Page
    x:Class="TempScore.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TempScore.App"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: open video, engine status, Score it -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Button x:Name="OpenVideoButton" Content="Open video..." Click="OnOpenVideoClick"/>
            <TextBlock x:Name="SelectedFileText" VerticalAlignment="Center" Text="No video selected" Opacity="0.7"/>
            <TextBlock x:Name="EngineStatusText" VerticalAlignment="Center" Text="Engine: checking..." Margin="24,0,0,0"/>
            <Button x:Name="ScoreItButton" Content="Score it" Click="OnScoreItClick" IsEnabled="False" Margin="24,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: playback -->
            <MediaPlayerElement x:Name="Player" Grid.Column="0" AreTransportControlsEnabled="True" Margin="12"/>

            <!-- Right: step list + editable plan -->
            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                    <TextBlock Text="Pipeline steps" FontWeight="SemiBold"/>
                    <ListView x:Name="StepListView" SelectionMode="None" MaxHeight="220"
                              ItemsSource="{x:Bind StepLabels}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="4">
                    <TextBlock Text="Music plan" FontWeight="SemiBold"/>
                    <ListView x:Name="PlanSegmentsListView" SelectionMode="None"
                              ItemsSource="{x:Bind PlanSegments}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlanSegmentViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                                    <TextBlock Text="{x:Bind RangeLabel}" Width="90" VerticalAlignment="Center"/>
                                    <Slider Minimum="1" Maximum="5" Value="{x:Bind Intensity, Mode=TwoWay}" Width="100"/>
                                    <TextBox Text="{x:Bind Prompt, Mode=TwoWay}" Width="220"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- MED-18/TMT-14: edit a segment above, then Regenerate reruns only
                         music+mux against whatever the panel currently shows. -->
                    <Button x:Name="RegenerateButton" Content="Regenerate"
                            Click="OnRegenerateClick" IsEnabled="False" Margin="0,8,0,0"/>

                    <!-- MED-18/TMT-14: mood slider -- always applied fresh to the original
                         plan, never compounded onto a previous mood word (see
                         MainPage.xaml.cs's OnApplyMoodClick). -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="Mood" VerticalAlignment="Center"/>
                        <Slider x:Name="MoodSlider" Minimum="1" Maximum="5" StepFrequency="1"
                                SnapsTo="StepValues" TickFrequency="1" TickPlacement="Outside"
                                Width="160" IsEnabled="False"/>
                        <Button x:Name="ApplyMoodButton" Content="Apply mood"
                                Click="OnApplyMoodClick" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
